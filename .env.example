# Copy to .env.local and fill in. NEVER commit a filled-in file.

# LiveKit is the media/SIP control plane. Agent logic and data run locally.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

DEEPGRAM_API_KEY=

# Either a Gemini API key, or Vertex via a service account.
GEMINI_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

TOOLS_API_URL=http://localhost:18091
TOOLS_TIMEOUT_SECONDS=5
DEMO_CALLER_ANI=+14155550201

AGENT_STT_MODEL=flux-general-en
AGENT_STT_MODEL_PHONE=nova-2-phonecall
AGENT_LLM_MODEL=gemini-2.5-flash-lite
AGENT_LLM_TEMPERATURE=0.2
AGENT_TTS_MODEL=aura-2-andromeda-en
